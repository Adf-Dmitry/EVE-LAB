!SWITCH 1
!
! 1. FORCE SHUTDOWN AND FULL DUPLEX  
enable
configure terminal
interface range ethernet 0/0-3, ethernet 1/0-3, ethernet 2/0-3, ethernet 3/0-3
duplex full
shutdown
exit
!
! 2. BASIC TROUBLESHOOTING 
ip routing 
vtp mode transparent
spanning-tree mode rapid-pvst
no ip igmp snooping
!
! 3. ALIAS CONFIGURATION 
alias exec seths show etherchannel summary
alias exec sinb show ip interface brief
alias exec sis show interface status
alias exec srun show running-config
alias exec ssbr show standby brief
alias exec stp show spanning-tree
alias exec svbr show vlan brief
alias exec svlan show vlan 
!
! 4. CONSOLE CONFIGURATION 
hostname SWL3_1
no ip domain-lookup
line console 0
logging synchronous
exec-timeout 0 0
history size 256
exit 
!
! 5. VLAN CONFIGURATION 
vlan 10
name IT
vlan 20
name HR
exit
!
! 6. LACP CONFIGURATION 
interface range ethernet 0/0-1
description *** TRUNK TO SWL3_2 ***
switchport
switchport trunk encapsulation dot1q
switchport mode trunk
channel-group 1 mode active
no shutdown
exit
!
interface port-channel 1 
description *** LACP TO SWL3_2 ***
no shutdown
exit
!
! 7. ACCESS VLAN CONFIGURATION 
interface ethernet 1/0
description *** LINK TO PC_1 IN IT ***
switchport
switchport mode access
switchport access vlan 10
no shutdown
exit
!
! 8. VIP AND HSRP
interface vlan 10
description *** GATEWAY FOR IT VLAN ***
ip address 192.168.10.2 255.255.255.0
no shutdown
standby version 2
standby 10 ip 192.168.10.1
standby 10 priority 110
standby 10 preempt 
exit
!
interface vlan 20
description *** GATEWAY FOR HR VLAN ***
ip address 192.168.20.2 255.255.255.0
no shutdown
standby version 2
standby 20 ip 192.168.20.1
standby 20 priority 100
standby 20 preempt 
exit
!
! 9. SAVE CONFIGURATION
end
write memory 
