!SWITCH 1
!
enable
configure terminal
interface range ethernet 0/0-3, ethernet 1/0-3, ethernet 2/0-3, ethernet 3/0-3
duplex full
shutdown
exit
!
ip routing 
vtp mode transparent
spanning-tree mode rapid-pvst
!
alias exec seths show etherchannel summary
alias exec sinb show ip interface brief
alias exec sis show interface status
alias exec srun show running-config
alias exec ssbr show standby brief
alias exec stp show spanning-tree
alias exec svbr show vlan brief
alias exec svlan show vlan 
!
no ip igmp snooping
hostname SWL3_1
no ip domain-lookup
line console 0
logging synchronous
exec-timeout 0 0
history size 256
exit 
!
vlan 10
name IT
vlan 20
name HR
exit
!
interface range ethernet 0/0-1
switchport
switchport trunk encapsulation dot1q
switchport mode trunk
channel-group 1 mode active
no shutdown
exit
!
interface ethernet 1/0
switchport
switchport mode access
switchport access vlan 10
no shutdown
!
interface port-channel 1 
no shutdown
end
!
write memory 
